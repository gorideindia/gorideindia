{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "**/*.html",
        "**/*.css",
        "**/*.js",
        "images/**"
      ]
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}